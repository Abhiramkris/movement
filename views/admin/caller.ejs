<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin – Call Requests</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      background-color: #f9f9f9;
    }

    h1 {
      background-color: #010f49;
      color: #fff;
      padding: 16px;
      text-align: center;
      margin: 0;
    }

    table {
      width: 95%;
      margin: 20px auto;
      border-collapse: collapse;
      background-color: #ffffff;
    }

    th,
    td {
      padding: 12px;
      border-bottom: 1px solid #ddd;
      text-align: left;
    }

    th {
      background-color: #f0f0f0;
      font-weight: bold;
    }

    tr:nth-child(even) {
      background-color: #fafafa;
    }

    .empty {
      text-align: center;
      padding: 30px;
      color: #777;
    }

    button {
      background-color: #dc3545;
      color: #fff;
      border: none;
      padding: 8px 14px;
      border-radius: 4px;
      cursor: pointer;
      font-size: 14px;
    }

    button:hover {
      background-color: #b52a37;
    }

    /* MOBILE */
    @media (max-width: 600px) {

      table,
      thead,
      tbody,
      th,
      td,
      tr {
        display: block;
      }

      thead {
        display: none;
      }

      tr {
        margin-bottom: 15px;
        border: 1px solid #ddd;
        padding: 10px;
        background: #fff;
      }

      td {
        padding-left: 50%;
        position: relative;
      }

      td::before {
        position: absolute;
        left: 10px;
        top: 12px;
        font-weight: bold;
        content: attr(data-label);
      }

      button {
        width: 100%;
        margin-top: 10px;
      }
    }
  </style>
</head>

<body>

  <h1>Call Requests</h1>

  <table>
    <thead>
      <tr>
        <th>Phone</th>
        <th>Name</th>
        <th>Action</th>
      </tr>
    </thead>

    <tbody>
      <% if (callRequests.length===0) { %>
        <tr>
          <td colspan="3" class="empty">No call requests found</td>
        </tr>
        <% } %>

          <% callRequests.forEach(req=> { %>
            <tr>
              <td data-label="Phone">
                <%= req.phone %>
              </td>
              <td data-label="Name">
                <%= req.name || '-' %>
              </td>
              <td data-label="Action">
                <form action="/admin/call/delete/<%= req.id %>" method="POST"
                  onsubmit="return confirm('Delete this call request?')">
                  <button type="submit">Delete</button>
                </form>
              </td>
            </tr>
            <% }) %>
    </tbody>
  </table>

</body>

</html>