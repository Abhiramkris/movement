        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#e11d48', // rose-600
        cancelButtonColor: '#6b7280',
        confirmButtonText: 'Yes, Delete All'
      }).then(async (result) => {
        if (result.isConfirmed) {
          try {
            showLoader(true);
            const res = await fetch('/admin/api/appointments/delete-past', {
              method: 'POST'
            });
