            if (!res.ok) throw new Error(data.error || 'Action failed');
            Swal.fire('Deleted!', `Successfully cleared ${data.deletedCount} past request(s).`, 'success');
            fetchAppointments();
          } catch (e) {
            Swal.fire('Error', 'Failed to delete past requests.', 'error');
          } finally {
            showLoader(false);
          }
        }
