    function renderAllView(filterQuery = '') {
      const tbody = document.getElementById('all-appointments-tbody');
      if (!tbody) return;
      tbody.innerHTML = '';

      const todayStr = new Date().toISOString().split('T')[0];

      // Calculate Stats (only for pending requests)
      let pendingList = allAppointments.filter(app => app.status === 'pending');

      let futureCount = 0;
      let pastCount = 0;

      pendingList.forEach(app => {
        const appDate = app.date ? (typeof app.date === 'string' ? app.date.split('T')[0] : new Date(app.date).toISOString().split('T')[0]) : 'N/A';
        if (appDate >= todayStr) futureCount++;
        else pastCount++;
      });

      document.getElementById('future-count').textContent = futureCount;
      document.getElementById('past-count').textContent = pastCount;

      const deleteBtn = document.getElementById('delete-past-btn');
      if (pastCount > 0) deleteBtn.classList.remove('hidden');
      else deleteBtn.classList.add('hidden');

      // Filter for rendering pending items in table
      let list = pendingList;
      if (filterQuery) {
        const q = filterQuery.toLowerCase();
        list = list.filter(a => a.name.toLowerCase().includes(q) || a.phone.includes(q));
      }

      if (list.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" class="p-12 text-center">
              <div class="w-16 h-16 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-3">
                  <i class="fas fa-inbox text-2xl text-gray-400"></i>
              </div>
              <h3 class="text-lg font-medium text-gray-900 mb-1">No Pending Requests Found</h3>
              <p class="text-gray-500 text-sm">All incoming requests have been processed.</p>
            </td>
          </tr>
        `;
        return;
      }

      // Sort pending list (oldest first, to process backlog)
      list.sort((a, b) => {
        const ad = a.date ? (typeof a.date === 'string' ? a.date.split('T')[0] : new Date(a.date).toISOString().split('T')[0]) : '9999';
        const bd = b.date ? (typeof b.date === 'string' ? b.date.split('T')[0] : new Date(b.date).toISOString().split('T')[0]) : '9999';
        return ad.localeCompare(bd);
      });

      list.forEach(app => {
        const appDate = app.date ? (typeof app.date === 'string' ? app.date.split('T')[0] : new Date(app.date).toISOString().split('T')[0]) : 'N/A';
        const isPast = appDate < todayStr;
        const rowClass = isPast ? 'bg-rose-50/30' : 'hover:bg-gray-50 transition';

        const tr = document.createElement('tr');
        tr.className = rowClass;
        tr.innerHTML = `
                    <td class="p-4">
                        <div class="font-bold text-gray-900">${app.name}</div>
                        <div class="text-sm text-gray-500">${app.phone}</div>
                    </td>
                    <td class="p-4">
                        <div class="text-gray-900 ${isPast ? 'text-red-500 font-medium' : ''}">${appDate} ${isPast ? '<i class="fas fa-exclamation-circle" title="Past Date"></i>' : ''}</div>
                        <div class="text-sm font-medium text-blue-600">${app.slot}</div>
                    </td>
                    <td class="p-4">
                        <div class="truncate max-w-[200px]" title="${app.address}">${app.address}</div>
                        <div class="text-xs text-gray-400">${app.city}</div>
                    </td>
                    <td class="p-4">
                        <span class="px-2.5 py-1 text-xs font-semibold rounded-full border bg-yellow-50 text-yellow-700 border-yellow-200 uppercase">
                            Pending
                        </span>
                    </td>
                    <td class="p-4 text-right flex justify-end gap-2">
                        <button onclick='handleApprove("${app.id}")' class="text-green-600 hover:text-green-800 bg-green-50 hover:bg-green-100 px-3 py-1.5 rounded-lg text-sm font-medium transition" title="Approve Request">
                            <i class="fas fa-check"></i>
                        </button>
                        <button onclick='handleReschedule("${app.id}", "${appDate}", "${app.slot}")' class="text-blue-600 hover:text-blue-800 bg-blue-50 hover:bg-blue-100 px-3 py-1.5 rounded-lg text-sm font-medium transition" title="Change Date/Time">
                            <i class="fas fa-clock"></i>
                        </button>
                        <button onclick='handleDelete("${app.id}")' class="text-red-600 hover:text-red-800 bg-red-50 hover:bg-red-100 px-3 py-1.5 rounded-lg text-sm font-medium transition" title="Cancel/Delete">
                            <i class="fas fa-trash"></i>
                        </button>
                    </td>
                `;
        tbody.appendChild(tr);
      });
    }

    async function fetchRescheduleRequests() {
      const tbody = document.getElementById('reschedule-requests-tbody');
      if (!tbody) return;

      showLoader(true);
      try {
        const res = await fetch('/admin/api/reschedule-requests');
        if (!res.ok) throw new Error('Failed to fetch reschedule requests');
        const requests = await res.json();

        renderRescheduleRequests(requests);
      } catch (err) {
        console.error(err);
        Swal.fire('Error', 'Failed to load reschedule requests', 'error');
      } finally {
        showLoader(false);
      }
    }

    function renderRescheduleRequests(requests) {
      const tbody = document.getElementById('reschedule-requests-tbody');
      tbody.innerHTML = '';

      if (requests.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" class="p-12 text-center text-gray-500 font-medium">
              <i class="fas fa-calendar-check text-4xl mb-3 block opacity-20"></i>
              No pending reschedule requests.
            </td>
          </tr>
        `;
        return;
      }

      requests.forEach(req => {
        const curDate = req.current_date ? (typeof req.current_date === 'string' ? req.current_date.split('T')[0] : new Date(req.current_date).toISOString().split('T')[0]) : 'N/A';
        const reqDate = req.requested_date ? (typeof req.requested_date === 'string' ? req.requested_date.split('T')[0] : new Date(req.requested_date).toISOString().split('T')[0]) : 'N/A';

        const tr = document.createElement('tr');
        tr.className = 'hover:bg-gray-50 transition';
        tr.innerHTML = `
          <td class="p-4 border-b">
            <div class="font-bold text-gray-900">${req.patient_name}</div>
            <div class="text-sm text-gray-500">${req.patient_phone}</div>
          </td>
          <td class="p-4 border-b text-sm">
            <div class="text-gray-400">Date: ${curDate}</div>
            <div class="text-gray-400">Slot: ${req.current_slot}</div>
          </td>
          <td class="p-4 border-b text-sm">
            <div class="text-blue-600 font-bold">New Date: ${reqDate}</div>
            <div class="text-blue-600 font-bold">New Slot: ${req.requested_slot}</div>
          </td>
          <td class="p-4 border-b">
            <div class="text-xs text-gray-600 italic line-clamp-2" title="${req.reason || ''}">${req.reason || '-'}</div>
          </td>
          <td class="p-4 border-b text-right">
            <div class="flex justify-end gap-2">
              <button onclick="handleApproveReschedule(${req.id})" class="bg-green-500 hover:bg-green-600 text-white px-3 py-1.5 rounded-lg text-sm font-medium transition flex items-center gap-1 shadow-sm">
                <i class="fas fa-check"></i> Approve
              </button>
              <button onclick="handleRejectReschedule(${req.id})" class="bg-red-50 hover:bg-red-100 text-red-600 px-3 py-1.5 rounded-lg text-sm font-medium transition flex items-center gap-1">
                <i class="fas fa-times"></i> Reject
              </button>
            </div>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    async function handleApproveReschedule(id) {
      const result = await Swal.fire({
        title: 'Approve Reschedule?',
        text: "The appointment will be updated to the new date and slot, and the patient will be notified.",
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#10b981',
        confirmButtonText: 'Yes, Approve It'
      });

      if (result.isConfirmed) {
        showLoader(true);
        try {
          const res = await fetch(`/admin/api/reschedule-requests/${id}/approve`, { method: 'POST' });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Failed to approve');

          Swal.fire('Approved!', 'The appointment has been rescheduled.', 'success');
          fetchRescheduleRequests();
          fetchAppointments(); // Refresh main list too
        } catch (err) {
          Swal.fire('Error', err.message, 'error');
        } finally {
          showLoader(false);
        }
      }
    }

    async function handleRejectReschedule(id) {
      const result = await Swal.fire({
        title: 'Reject Request?',
        text: "The patient will be notified that their request could not be accommodated.",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#ef4444',
        confirmButtonText: 'Yes, Reject It'
      });

      if (result.isConfirmed) {
        showLoader(true);
        try {
          const res = await fetch(`/admin/api/reschedule-requests/${id}/reject`, { method: 'POST' });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Failed to reject');

          Swal.fire('Rejected', 'The request has been marked as rejected.', 'success');
          fetchRescheduleRequests();
        } catch (err) {
          Swal.fire('Error', err.message, 'error');
        } finally {
          showLoader(false);
        }
      }
    }

