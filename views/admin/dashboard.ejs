    async function updateAppointment(id, data) {
      showLoader(true);
      try {
        const res = await fetch(`/admin/api/appointment/${id}/notes`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            status: id.startsWith('req_') ? 'pending' : 'scheduled', // Keep current status
            ...data
          })
        });

        if (!res.ok) throw new Error('Update failed');
        Swal.fire('Success', 'Appointment rescheduled successfully.', 'success');
        fetchAppointments();
      } catch (e) {
        Swal.fire('Error', 'Failed to update appointment.', 'error');
      } finally {
        showLoader(false);
      }
    }

