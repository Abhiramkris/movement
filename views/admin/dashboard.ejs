    // --- Clinical Trail Modal (SOAP) ---
    async function openClinicalModal(appointment) {
      const modal = document.getElementById('patient-modal');
      const form = document.getElementById('clinical-notes-form');

      // Set Headers
      document.getElementById('modal-patient-name').textContent = appointment.name;
      document.getElementById('modal-patient-phone').textContent = appointment.phone;
      document.getElementById('active-appointment-id').value = appointment.id;

      const appDateStr = appointment.date ? (typeof appointment.date === 'string' ? appointment.date.split('T')[0] : new Date(appointment.date).toISOString().split('T')[0]) : 'Unknown Date';
      document.getElementById('active-session-date').textContent = `${appDateStr} | ${appointment.slot}`;

      // Populate Active Form
      const statusRadios = form.elements['status'];
      statusRadios.value = appointment.status || 'scheduled';

      let notesObj = { s: '', o: '', ap: '' };
      if (appointment.clinical_notes) {
        try {
          notesObj = typeof appointment.clinical_notes === 'string' ? JSON.parse(appointment.clinical_notes) : appointment.clinical_notes;
        } catch (e) { }
      }
      document.getElementById('note-s').value = notesObj.s || '';
      document.getElementById('note-o').value = notesObj.o || '';
      document.getElementById('note-ap').value = notesObj.ap || '';

      // Fetch & Render History Trail
      await buildHistoryTrail(appointment.phone, appointment.id);

      // Show Modal
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden'; // Prevent bg scrolling
    }

    function closeModal() {
      const modal = document.getElementById('patient-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    }

    async function buildHistoryTrail(phone, currentAppointmentId) {
      const timelineContainer = document.getElementById('history-timeline');
      const badge = document.getElementById('visit-count-badge');

      timelineContainer.innerHTML = '<div class="text-center text-gray-400 py-4"><i class="fas fa-spinner fa-spin"></i> Loading...</div>';

      try {
        const response = await fetch(`/admin/api/patient/${encodeURIComponent(phone)}/history`);
        if (!response.ok) throw new Error('Fetch failed');
        const history = await response.json();

        badge.textContent = `${history.length} Visit(s)`;
        timelineContainer.innerHTML = '';

        if (history.length <= 1) { // 1 is the current appointment
          timelineContainer.innerHTML = '<div class="text-sm text-gray-500 italic pl-10 border-l-2 border-dashed border-gray-200 ml-4 py-4">No past visits recorded for this phone number.</div>';
          return;
        }

        history.forEach((visit, index) => {
          const isCompleted = visit.status === 'completed';
          if (!isCompleted && visit.id !== currentAppointmentId) return; // Only show completed past visits or the current one

          const vDate = visit.date ? (typeof visit.date === 'string' ? visit.date.split('T')[0] : new Date(visit.date).toISOString().split('T')[0]) : 'Date';
          const isActive = visit.id === currentAppointmentId;

          let notesStr = "No clinical notes recorded.";
          if (visit.clinical_notes) {
            try {
              const n = typeof visit.clinical_notes === 'string' ? JSON.parse(visit.clinical_notes) : visit.clinical_notes;
              const parts = [];
              if (n.s) parts.push(`<p><strong>S:</strong> ${n.s}</p>`);
              if (n.o) parts.push(`<p><strong>O:</strong> ${n.o}</p>`);
              if (n.ap) parts.push(`<p><strong>A/P:</strong> ${n.ap}</p>`);
              if (parts.length > 0) notesStr = parts.join('');
            } catch (e) { }
          }

          const dotColor = isActive ? 'bg-blue-500 border-4 border-blue-100 shadow-blue-500/30' : 'bg-gray-300 border-4 border-white';
          const cardStyle = isActive ? 'border-blue-200 bg-white shadow-md' : 'border-gray-100 bg-gray-50';

          const itemHtml = `
            <div class="relative pl-12 py-2">
                             <!--Timeline Dot-->
                             <div class="absolute left-0 top-6 ml-[-4px] md:ml-[16px] w-4 h-4 rounded-full ${dotColor} shadow-sm z-10 transition-colors duration-200"></div>
                             
                             <!--Content Card-->
            <div class="rounded-2xl p-4 border ${cardStyle}">
              <div class="flex justify-between items-start mb-2">
                <span class="font-bold text-gray-900">${vDate}</span>
                ${isActive ? '<span class="text-xs bg-blue-100 text-blue-700 px-2 rounded font-semibold">Editing Now</span>' : ''}
              </div>
              <div class="text-sm text-gray-600 prose prose-sm leading-snug">
                ${notesStr}
              </div>
            </div>
                        </div>
              `;
          timelineContainer.insertAdjacentHTML('beforeend', itemHtml);
        });

      } catch (error) {
        console.error('History fetch error', error);
        timelineContainer.innerHTML = '<div class="text-red-500 text-sm">Failed to load history.</div>';
      }
    }

    async function handleNotesSave(e) {
      e.preventDefault();
      const id = document.getElementById('active-appointment-id').value;
      const status = document.querySelector('input[name="status"]:checked').value;

      const clinical_notes = {
        s: document.getElementById('note-s').value.trim(),
        o: document.getElementById('note-o').value.trim(),
        ap: document.getElementById('note-ap').value.trim()
      };

      const btn = e.target.querySelector('button[type="submit"]');
      const originalText = btn.innerHTML;
      btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Saving...';
      btn.disabled = true;

      try {
        const response = await fetch(`/admin/api/appointment/${id}/notes`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status, clinical_notes })
        });

        if (!response.ok) throw new Error('Save failed');

        Swal.fire({
          title: 'Saved!',
          text: 'Clinical record updated successfully.',
          icon: 'success',
          timer: 1500,
          showConfirmButton: false
        });

        // Refresh data
        await fetchAppointments();

        // Keep modal open but update trail (rebuild)
        const phone = document.getElementById('modal-patient-phone').textContent.replace('+', '').trim(); // clean UI phone
        await buildHistoryTrail(phone, id);

      } catch (error) {
        Swal.fire('Error', 'Failed to save notes. Try again.', 'error');
      } finally {
        btn.innerHTML = originalText;
        btn.disabled = false;
      }
    }

    async function handleApprove(id) {
      Swal.fire({
        title: 'Approve Appointment?',
        text: "This will move the appointment to approved and send a confirmation email to the patient.",
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#16a34a',
        cancelButtonColor: '#6b7280',
        confirmButtonText: 'Yes, Approve'
      }).then(async (result) => {
        if (result.isConfirmed) {
          try {
            showLoader(true);
            const res = await fetch('/admin/approve', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id })
            });
            if (!res.ok) throw new Error('Action failed');
            Swal.fire('Approved!', 'The appointment has been confirmed and the patient notified.', 'success');
            fetchAppointments();
          } catch (e) {
            Swal.fire('Error', 'Failed to approve. Try again.', 'error');
          } finally {
            showLoader(false);
          }
        }
      });
    }

    async function handleDelete(id) {
      Swal.fire({
        title: 'Cancel Request?',
        text: "This will permanently delete the request and notify the patient via email.",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc2626',
        cancelButtonColor: '#6b7280',
        confirmButtonText: 'Yes, Cancel it'
      }).then(async (result) => {
        if (result.isConfirmed) {
          try {
            showLoader(true);
            const res = await fetch('/admin/delete', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id })
            });
            if (!res.ok) throw new Error('Action failed');
            Swal.fire('Deleted!', 'The request has been removed and the patient notified.', 'success');
            fetchAppointments();
          } catch (e) {
            Swal.fire('Error', 'Failed to delete. Try again.', 'error');
          } finally {
            showLoader(false);
          }
        }
      });
    }

    // --- Helpers & UI Interactivity ---
    function showLoader(show) {
      document.getElementById('loader').classList.toggle('hidden', !show);
    }

    let toggleSidebar; // Declare globally for switchTab to use

    function setupSidebarMobile() {
      const btn = document.getElementById('mobile-menu-btn');
      const sidebar = document.getElementById('sidebar');
      const overlay = document.getElementById('sidebar-overlay');
      const closeBtn = document.getElementById('close-sidebar-btn');

      toggleSidebar = function () {
        const isClosed = sidebar.classList.contains('-translate-x-full');
        if (isClosed) {
          sidebar.classList.remove('-translate-x-full');
          overlay.classList.remove('hidden');
        } else {
          sidebar.classList.add('-translate-x-full');
          overlay.classList.add('hidden');
        }
      };

      btn.addEventListener('click', toggleSidebar);
      closeBtn.addEventListener('click', toggleSidebar);
      overlay.addEventListener('click', toggleSidebar);
    }

    function setupSearch() {
      document.getElementById('global-search').addEventListener('input', (e) => {
        const val = e.target.value;
        const isApproved = !document.getElementById('view-approved').classList.contains('hidden');
        if (isApproved) {
          renderApprovedView(val);
        } else {
          renderAllView(val);
        }
      });
    }

    function setupWebSocketNotifications() {
      // Request Perms
      if (Notification.permission !== 'granted' && Notification.permission !== 'denied') {
        Notification.requestPermission();
      }

      const connectWS = () => {
        // Use wss based on window location
        const prot = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
        const wsUrl = `${prot}//${window.location.host}`;

        console.log("Connecting WS to:", wsUrl);
        const ws = new WebSocket(wsUrl);

        ws.onmessage = e => {
          const m = JSON.parse(e.data);

          // Native Notification
          if (Notification.permission === 'granted') {
            const notif = new Notification(m.title, { body: m.body, icon: '/images/logo.png' });
            notif.onclick = () => { window.focus(); fetchAppointments(); };
          }

          // Toast Overlay
          const Toast = Swal.mixin({
            toast: true, position: 'top-end', showConfirmButton: false, timer: 5000,
            timerProgressBar: true, didOpen: (toast) => {
              toast.addEventListener('mouseenter', Swal.stopTimer)
              toast.addEventListener('mouseleave', Swal.resumeTimer)
            }
          });
          Toast.fire({ icon: 'info', title: m.title, text: m.body });

          // Wake up effect on bell
          const badge = document.getElementById('notif-badge');
          badge.classList.remove('hidden');
          setTimeout(() => badge.classList.add('hidden'), 5000);

          // Auto-refresh data
          fetchAppointments();
        };

        ws.onclose = () => {
          console.log("WS closed, retrying in 3s...");
          setTimeout(connectWS, 3000);
        };

        ws.onerror = (err) => {
          console.error('WS Error');
        };
      };

      connectWS();
    }
  </script>
</body>

