<!-- admin/dashboard.ejs -->
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Appointments Dashboard</title>

  <link rel="stylesheet" href="css/imagetext.css">
  <link rel="stylesheet" href="css/style.css">
  <link rel="stylesheet" href="css/aura.css">
  <link rel="stylesheet" href="css/nav.css">
  <link rel="stylesheet" href="css/footer.css">

  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

  <style>
    body {
      background: #f4f6f9;
      font-family: Poppins, sans-serif
    }

    .dashboard-header {
      font-size: 26px;
      font-weight: 600;
      margin: 20px 0
    }

    .admin-toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 15px
    }

    .admin-toolbar button {
      background: #2563eb;
      color: #fff;
      border: none;
      padding: 8px 14px;
      border-radius: 8px;
      font-size: 14px;
      display: flex;
      align-items: center;
      gap: 6px
    }

    .admin-toolbar button.secondary {
      background: #6b7280
    }

    .filter-bar {
      background: #fff;
      padding: 12px;
      border-radius: 10px;
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      box-shadow: 0 6px 18px rgba(0, 0, 0, .06)
    }

    .filter-bar input,
    .filter-bar button {
      padding: 8px 12px;
      border-radius: 6px;
      border: 1px solid #ddd
    }

    .search-box {
      flex: 1
    }

    .appointments-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 18px;
      margin-top: 20px
    }

    .appointment-card {
      background: #fff;
      padding: 16px;
      border-radius: 12px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, .07)
    }

    .appointment-card h6 {
      font-weight: 600;
      margin-bottom: 6px
    }

    .appointment-card p {
      font-size: 14px;
      margin: 0;
      color: #4b5563
    }

    .appointment-actions {
      margin-top: 10px;
      display: flex;
      flex-wrap: wrap;
      gap: 6px
    }

    .appointment-actions input {
      flex: 1;
      padding: 6px 8px;
      border-radius: 6px;
      border: 1px solid #ddd
    }

    .appointment-actions button {
      border: none;
      border-radius: 6px;
      padding: 6px 10px;
      font-size: 13px;
      color: #fff
    }

    .approve-btn {
      background: #16a34a
    }

    .delete-btn {
      background: #dc2626
    }

    .whatsapp-btn {
      background: #22c55e
    }

    .pagination-bar {
      text-align: center;
      margin: 25px 0
    }

    .pagination-bar button {
      margin: 0 4px;
      padding: 6px 12px;
      border-radius: 6px;
      border: none;
      background: #e5e7eb
    }

    .pagination-bar button.active {
      background: #2563eb;
      color: #fff
    }

    .toast-container {
      position: fixed;
      top: 20px;
      right: 20px;
      z-index: 9999
    }
  </style>
</head>

<body>

  <nav class="navbar navbar-expand-lg navbar-light">
    <div class="name">
      <h5>MOVEMENT SCIENCE</h5>
    </div>
  </nav>

  <div class="container-fluid">
    <div class="dashboard-header">Admin Dashboard</div>

    <!-- ADMIN TOOLBAR -->
    <div class="admin-toolbar">
      <button id="logout-btn" class="secondary"><i class="fas fa-sign-out-alt"></i> Logout</button>
      <a href="/admin/call"><button><i class="fas fa-phone"></i> Calls</button></a>
      <button id="see-history-btn"><i class="fas fa-history"></i> History</button>
      <a href="/appointmentsall"><button><i class="fas fa-check-circle"></i> Approved</button></a>
      <a href="/admin/live-chat-queries"><button><i class="fas fa-comments"></i> Live Chat</button></a>
    </div>

    <!-- FILTER + SEARCH -->
    <div class="filter-bar">
      <form action="/admin/dashboard" method="GET" style="display:flex;gap:10px">
        <input type="date" name="date" value="<%= filterDate %>">
        <button type="submit">Filter</button>
        <button type="button" id="clear-filter">Clear</button>
      </form>
      <input type="text" id="searchInput" class="search-box" placeholder="Search name / phone / email">
    </div>

    <!-- APPOINTMENTS -->
    <div class="appointments-grid" id="appointmentsGrid">
      <% appointments.forEach(appointment=>{ %>
        <div class="appointment-card searchable">
          <h6>
            <%= appointment.name %>
          </h6>
          <p><strong>Date:</strong>
            <%= appointment.date %>
          </p>
          <p><strong>Slot:</strong>
            <%= appointment.slot %>
          </p>
          <p><strong>Phone:</strong>
            <%= appointment.phone %>
          </p>
          <p><strong>Email:</strong>
            <%= appointment.email %>
          </p>
          <p><strong>City:</strong>
            <%= appointment.city %>
          </p>
          <p><strong>Address:</strong>
            <%= appointment.address %>
          </p>

          <div class="appointment-actions">
            <input type="text" id="remarks-<%= appointment.id %>" placeholder="Remarks">
            <button class="approve-btn" data-appointment-id="<%= appointment.id %>">Approve</button>
            <button class="delete-btn" data-appointment-id="<%= appointment.id %>">Delete</button>
            <button class="whatsapp-btn" data-phone-number="<%= appointment.phone %>">WhatsApp</button>
          </div>
        </div>
        <% }) %>
    </div>

    <div class="pagination-bar" id="pagination"></div>
  </div>

  <!-- TOAST -->
  <div class="toast-container"></div>

  <script>
    function showToast(msg, type = "info") {
      const toast = $(`
  <div class="toast" data-delay="3000">
    <div class="toast-body bg-${type} text-white">${msg}</div>
  </div>`);
      $(".toast-container").append(toast);
      toast.toast("show").on("hidden.bs.toast", () => toast.remove());
    }

    /* SEARCH */
    $("#searchInput").on("keyup", function () {
      const v = $(this).val().toLowerCase();
      $(".searchable").each(function () {
        $(this).toggle($(this).text().toLowerCase().includes(v));
      });
    });

    /* PAGINATION */
    const cards = $(".searchable"); let perPage = 6; let page = 1;
    function render() {
      cards.hide();
      cards.slice((page - 1) * perPage, page * perPage).show();
    }
    function pager() {
      let pages = Math.ceil(cards.length / perPage); let html = "";
      for (let i = 1; i <= pages; i++) html += `<button class="${i == page ? 'active' : ''}" onclick="page=${i};render()">${i}</button>`;
      $("#pagination").html(html);
    }
    pager(); render();

    /* CLEAR FILTER */
    $("#clear-filter").click(() => location.href = "/admin/dashboard");

    /* LOGOUT */
    $("#logout-btn").click(() => location.href = "/admin/logout");

    /* WEBSOCKET (SINGLE + MOBILE SAFE) */
    let ws;
    function connectWS() {
      ws = new WebSocket("wss://localhost:8080");
      ws.onmessage = e => {
        const m = JSON.parse(e.data);
        showToast(m.title + ": " + m.body, "primary");
      };
      ws.onclose = () => setTimeout(connectWS, 3000);
    }
    connectWS();
  </script>

  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<!-- Popper.js -->
<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
<!-- Bootstrap JS -->
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</html>