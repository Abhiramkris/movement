<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Services We Offer</title>
  <link rel="stylesheet" href="/css/imagetext.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/aura.css">
  <link rel="stylesheet" href="/css/nav.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
  <!-- Font Awesome CSS -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  <!-- cdn tailwing -->
  <link
    href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
    rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-uWxY/CJNBR+1zjPWmfnSnVxwRheevXITnMqoEIeG1LJrdI0GlVs/9cVSyPYXdcSF" crossorigin="anonymous">
  <!-- JavaScript Bundle with Popper -->
</head>

<style>
  /* styles.css */
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: Arial, sans-serif;
  }

  .content-wrapper {
    margin: 0 auto;
    /* Center the content horizontally */
    max-width: 1200px;
    /* Adjust as needed */
    padding: 20px;
  }

  .container {
    max-width: 100%;
    /* Full width within the content wrapper */
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    max-width: 100%;
  }

  .box {
    display: flex;
    flex-direction: column;
    width: 100%;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
    /* Updated box shadow with more vibrancy */
    margin-bottom: 20px;
  }

  .left {
    order: 2;
    /* Text will be on top in mobile view */
    padding: 20px;
    flex: 1;
  }

  .right {
    order: 1;
    /* Image will be at the bottom in mobile view */
    flex: 1;
    position: relative;
    padding-bottom: 100%;
    /* Aspect ratio of 1:1 to make it square */
  }

  .right img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .left h2 {
    margin-bottom: 10px;
    border-bottom: 2px solid #007BFF;
    /* Updated to blue color */
    display: inline-block;
    text-transform: uppercase;
    /* Make heading text uppercase */
  }

  .left p {
    margin-bottom: 10px;
    /* Make description text uppercase */
  }

  h5 {
    margin-top: 8px;
    font-weight: 800;
    color: rgb(1, 19, 67);
    font-family: 'Poppins', sans-serif;
  }

  .left button {
    padding: 5px 20px;
    background: linear-gradient(45deg, #1d1acb, #008CBA);
    color: white;
    border: none;
    cursor: pointer;
    border-radius: 5px;
    text-transform: uppercase;
    /* Make button text uppercase */
  }

  .left button:hover {
    background-color: #0056b3;
  }

  @media (min-width: 768px) {
    .box {
      flex-direction: row;
      align-items: center;
    }

    .left {
      order: 1;
      flex: 2;
      padding: 20px;
    }

    .right {
      order: 2;
      flex: 1;
      padding-bottom: 0;
      width: 300px;
      height: 300px;
    }

    .right img {
      width: 100%;
      height: 100%;
    }
  }

  .herohero {
    margin-top: 120px;
    margin-bottom: 40px;
  }

  @media (max-width: 700px) {
    .herohero {
      margin-left: 20px;
      width: 90%;
    }
  }
</style>

<body>

  <%- include('../header') %>
    <br><br> <br><br>
    <div class="content-wrapper">
      <div class="herohero">
        <div class="header">Providing Expert Care for a Range of Conditions</div>
        <div class="subhead" style="margin-top: 20px;">Need Professional Guidance?</div>
        <div class="subhead">Our dedicated team creates customized treatment plans tailored to your needs, helping you
          achieve your health goals and live a pain-free life. Contact our specialist case managers to discuss your
          requirements.</div>
      </div>
    </div>

    <div class="content-wrapper" style="padding-top: 0;">
      <div class="container">
        <% for(let i = 0; i < services.length; i += 2) { %>
          <div class="row">
            <% for(let j = i; j < i + 2 && j < services.length; j++) { 
                const service = services[j];
            %>
              <div class="box">
                <div class="left">
                  <h2><%= service.title %></h2>
                  <p><%= service.metaDescription || service.intro %></p>
                  <a href="/services/<%= service.slug %>"><button>More</button></a>
                </div>
                <div class="right">
                  <img src="<%= service.image %>" alt="<%= service.title %>">
                </div>
              </div>
            <% } %>
          </div>
        <% } %>
      </div>
    </div>
</body>
</div>
<%- include('../footer') %>
  <!-- jQuery -->
  <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
  <!-- Popper.js -->
  <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
  <!-- Bootstrap JS -->
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
  </body>

</html>