<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= page.metaTitle %>
    </title>
    <meta name="description" content="<%= page.metaDescription %>">
    <meta name="keywords" content="<%= page.keywords %>">

    <!-- External Resources -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/aura.css">
    <link rel="stylesheet" href="/css/footer.css">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
        }

        .hero-gradient {
            background: linear-gradient(135deg, #011d3b 0%, #023974 100%);
        }

        /* Robust Mobile Menu Styles */
        #mobile-menu {
            display: none;
            position: absolute;
            top: 80px;
            left: 0;
            width: 100%;
            background: white;
            z-index: 40;
            border-bottom: 2px solid #f3f4f6;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }

        #mobile-menu.active {
            display: block;
        }

        @media (min-width: 768px) {
            #mobile-menu {
                display: none !important;
            }
        }
    </style>
</head>

<body class="bg-gray-50 text-gray-900 leading-relaxed">

    <!-- Navbar -->
    <nav class="fixed w-full z-50 bg-white/90 backdrop-blur-md shadow-sm h-20 flex items-center">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full flex justify-between items-center">
            <div class="flex items-center">
                <a href="/" class="flex items-center">
                    <img src="/images/logo.png" alt="Logo" class="h-10 md:h-12 w-auto">
                    <span
                        class="ml-3 font-extrabold text-[#011343] text-lg md:text-xl tracking-tight hidden sm:block">MOVEMENT
                        SCIENCE</span>
                </a>
            </div>

            <!-- Desktop Menu -->
            <div class="hidden md:flex space-x-8 font-medium">
                <a href="/howhelp/index" class="text-gray-600 hover:text-blue-600 transition">How we help</a>
                <a href="/services" class="text-blue-600 border-b-2 border-blue-600">Services</a>
                <a href="/conditions" class="text-gray-600 hover:text-blue-600 transition">Conditions</a>
                <a href="/faq" class="text-gray-600 hover:text-blue-600 transition">FAQ</a>
                <a href="/about" class="text-gray-600 hover:text-blue-600 transition">About Us</a>
            </div>

            <div class="flex items-center space-x-3">
                <a href="/checkslot"
                    class="hidden sm:block bg-blue-600 text-white px-5 py-2 rounded-full font-semibold hover:bg-blue-700 transition shadow-lg shadow-blue-200 text-sm">
                    Book Now
                </a>

                <!-- Hamburger Button -->
                <button id="mobile-menu-button"
                    class="md:hidden p-2 rounded-lg text-gray-600 hover:bg-gray-100 transition">
                    <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            </div>
        </div>

        <!-- Mobile Menu -->
        <div id="mobile-menu" class="md:hidden">
            <div class="px-4 py-6 space-y-4">
                <a href="/howhelp/index" class="block text-lg text-gray-600">How we help</a>
                <a href="/services" class="block text-lg font-bold text-blue-600">Services</a>
                <a href="/conditions" class="block text-lg text-gray-600">Conditions</a>
                <a href="/faq" class="block text-lg text-gray-600">FAQ</a>
                <a href="/about" class="block text-lg text-gray-600">About Us</a>
                <hr class="border-gray-100">
                <a href="/checkslot"
                    class="block w-full text-center bg-blue-600 text-white py-4 rounded-xl font-bold">Book Free
                    Consultation</a>
            </div>
        </div>
    </nav>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const menuBtn = document.getElementById('mobile-menu-button');
            const mobileMenu = document.getElementById('mobile-menu');

            if (menuBtn && mobileMenu) {
                menuBtn.addEventListener('click', () => {
                    mobileMenu.classList.toggle('active');
                });
            }
        });
    </script>

    <!-- Hero Section -->
    <section class="pt-32 pb-20 hero-gradient text-white overflow-hidden relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="md:w-2/3">
                <nav class="flex mb-4 text-blue-200 text-sm font-medium" aria-label="Breadcrumb">
                    <a href="/" class="hover:text-white transition">Home</a>
                    <span class="mx-2">/</span>
                    <a href="/services" class="hover:text-white transition">Services</a>
                </nav>
                <h1 class="text-4xl md:text-6xl font-extrabold mb-6 tracking-tight leading-tight">
                    <%= page.title %>
                </h1>
                <p class="text-xl text-blue-100 mb-8 leading-relaxed max-w-2xl">
                    <%= page.intro %>
                </p>
            </div>
        </div>
        <!-- Logo Watermark -->
        <div
            class="absolute top-0 right-0 w-1/2 h-full opacity-10 pointer-events-none flex justify-end items-center overflow-hidden">
            <img src="/images/logo.png" alt="Watermark" class="w-auto h-[150%] max-w-none transform translate-x-1/4"
                style="filter: brightness(0) invert(1);">
        </div>
    </section>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="flex flex-col lg:flex-row gap-12">

            <!-- Article Content -->
            <div class="lg:w-2/3">
                <img src="<%= page.image %>" alt="<%= page.title %>"
                    class="w-full h-96 object-cover rounded-3xl shadow-xl mb-12 transform hover:scale-[1.01] transition duration-500">

                <div class="prose prose-lg max-w-none text-gray-700">
                    <% page.contentSections.forEach(section=> { %>
                        <div class="mb-12">
                            <h2 class="text-3xl font-bold text-gray-900 mb-6 flex items-center">
                                <span class="w-8 h-1 bg-blue-600 mr-4 rounded-full"></span>
                                <%= section.heading %>
                            </h2>
                            <p class="whitespace-pre-line leading-relaxed">
                                <%= section.body %>
                            </p>
                        </div>
                        <% }); %>
                </div>

                <!-- Explicit Outro Section -->
                <div class="bg-gray-100 p-8 rounded-2xl border-l-4 border-blue-600 mt-8 italic">
                    <p class="text-gray-800">
                        <%= page.outro %>
                    </p>
                </div>
            </div>

            <!-- Sidebar -->
            <aside class="lg:w-1/3">
                <div class="sticky top-28 space-y-8">

                    <!-- Other Services -->
                    <div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100">
                        <h3 class="text-xl font-bold mb-6 text-gray-900">Expert Services</h3>
                        <div class="space-y-4">
                            <% allPages.forEach(otherPage=> { %>
                                <a href="/services/<%= otherPage.slug %>"
                                    class="block p-4 rounded-2xl transition duration-200 <%= otherPage.slug === page.slug ? 'bg-blue-50 text-blue-700 font-semibold border-l-4 border-blue-600' : 'hover:bg-gray-50 text-gray-600 hover:text-blue-600' %>">
                                    <%= otherPage.title %>
                                </a>
                                <% }); %>
                        </div>
                    </div>

                    <!-- CTA Box -->
                    <div class="bg-blue-600 p-8 rounded-3xl shadow-xl text-white relative overflow-hidden">
                        <div class="relative z-10">
                            <h3 class="text-2xl font-bold mb-4">Need Help?</h3>
                            <p class="text-blue-100 mb-6">Our dedicated team is ready to help you achieve your health
                                goals and live a pain-free life.</p>
                            <a href="/checkslot"
                                class="block w-full text-center bg-white text-blue-600 py-4 rounded-2xl font-bold hover:bg-blue-50 transition shadow-lg">
                                Book Free Consultation
                            </a>
                            <div class="mt-4 flex items-center justify-center space-x-3 text-sm text-blue-200">
                                <i class="fas fa-phone"></i>
                                <a href="tel:+44 07930167674" class="hover:text-white transition">+44 07930167674</a>
                            </div>
                        </div>
                        <!-- Decorative Circle -->
                        <div class="absolute -bottom-10 -right-10 w-40 h-40 bg-white/10 rounded-full blur-2xl"></div>
                    </div>
                </div>
            </aside>
        </div>
    </main>

    <%- include('../footer') %>

</body>

</html>