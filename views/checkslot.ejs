<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Check Slots</title>

  <!-- EXISTING LINKS (UNCHANGED) -->
  <link rel="stylesheet" href="css/style.css">
  <link rel="stylesheet" href="css/aura.css">
  <link rel="stylesheet" href="css/nav.css">
  <link rel="stylesheet" href="css/footer.css">
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.12/css/intlTelInput.css" />
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Google Sans', Arial, sans-serif;
      background-color: #f2f3f5;
      margin: 0;
      padding: 0;
    }

    /* DATE STRIP */
    .date-strip {
      display: flex;
      gap: 12px;
      overflow-x: auto;
      padding: 16px;
      margin-bottom: 16px;
    }

    .date-pill {
      min-width: 64px;
      padding: 10px 6px;
      text-align: center;
      border-radius: 12px;
      background: #ffffff;
      border: 1px solid #e0e0e0;
      cursor: pointer;
      transition: all 0.2s ease;
      font-size: 13px;
    }

    .date-pill strong {
      display: block;
      font-size: 16px;
    }

    .date-pill.active {
      background: #022852;
      color: #ffffff;
      border-color: #022852;
    }

    /* Card */
    .container {
      background-color: #ffffff;
      padding: 24px;
      border-radius: 14px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
      width: 100%;
      max-width: 420px;
    }

    h1 {
      font-size: 22px;
      font-weight: 600;
      margin-bottom: 12px;
    }

    label {
      font-size: 13px;
      font-weight: 500;
      color: #666;
    }

    input[type="date"],
    input[type="tel"],
    select {
      width: 100%;
      padding: 14px;
      font-size: 15px;
      border-radius: 10px;
      border: 1px solid #ddd;
      background: #fafafa;
      margin-bottom: 14px;
    }

    .slots {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-top: 16px;
    }

    .slot input {
      display: none;
    }

    .slot label {
      display: block;
      padding: 14px 0;
      text-align: center;
      border-radius: 10px;
      border: 1px solid #e0e0e0;
      background: #ffffff;
      font-size: 14px;
      cursor: pointer;
    }

    .slot input:checked+label {
      background: #022852;
      color: #ffffff;
      border-color: #022852;
    }

    .btn {
      width: 100%;
      margin-top: 24px;
      padding: 16px;
      font-size: 16px;
      font-weight: 600;
      border-radius: 12px;
      background: #045edb;
      color: white;
      border: none;
    }

    .btn:disabled {
      opacity: 0.6;
    }

    #phone {
      width: 100%;
    }
  </style>
</head>

<body>

  <!-- NAVBAR (UNCHANGED) -->
  <%- include('header') %>

  <br><br>

  <!-- DATE STRIP -->
  <div class="date-strip" id="dateStrip"></div>

  <div class="container">
    <h1>Check Slots</h1>

    <form id="appointmentForm">

      <!-- CUSTOM DATE INPUT (STILL EXISTS) -->
      <label>Date (Custom):</label>
      <input type="date" id="date" name="date" required>
      <br>
      <label>Phone Number:</label> <br>
      <input type="tel" id="phone" required>
      <br>
      <label>City:</label>
      <select id="city" required>
        <option>Maidenhead</option>
        <option>Windsor</option>
        <option>Reading</option>
      </select>
      <br>
      <div class="slots">
        <div class="slot">
          <input type="radio" id="slot1" name="slot" value="slot1" required>
          <label for="slot1">10:00 AM</label>
        </div>
        <div class="slot">
          <input type="radio" id="slot2" name="slot" value="slot2">
          <label for="slot2">11:00 AM</label>
        </div>
        <div class="slot">
          <input type="radio" id="slot3" name="slot" value="slot3">
          <label for="slot3">12:00 PM</label>
        </div>
        <div class="slot" id="slot4-container" style="display:none;">
          <input type="radio" id="slot4" name="slot" value="slot4">
          <label for="slot4">04:30 PM</label>
        </div>
        <div class="slot" id="slot5-container" style="display:none;">
          <input type="radio" id="slot5" name="slot" value="slot5">
          <label for="slot5">05:00 PM</label>
        </div>
        <div class="slot" id="slot6-container" style="display:none;">
          <input type="radio" id="slot6" name="slot" value="slot6">
          <label for="slot6">06:15 PM</label>
        </div>
      </div>

      <button class="btn" id="checkBtn">Check Availability</button>
    </form>
  </div>
  <script>
    const strip = document.getElementById('dateStrip');
    const dateInput = document.getElementById('date');

    for (let i = 0; i < 10; i++) {
      const d = new Date();
      d.setDate(d.getDate() + i);

      const pill = document.createElement('div');
      pill.className = 'date-pill';
      pill.innerHTML = `<strong>${d.getDate()}</strong>${d.toLocaleDateString('en-US', { weekday: 'short' })}`;

      pill.onclick = () => {
        document.querySelectorAll('.date-pill').forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        dateInput.value = d.toISOString().split('T')[0];
      };

      if (i === 0) pill.classList.add('active');
      strip.appendChild(pill);
    }
  </script>
  <br><br>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.12/js/intlTelInput.min.js"></script>
  <script>
    let btnstatus = false
    document.addEventListener('DOMContentLoaded', function () {
      const checkBtn = document.getElementById("checkBtn");
      const phoneInputField = document.querySelector("#phone");
      const iti = window.intlTelInput(phoneInputField, {
        initialCountry: "auto", // or your default country code
        utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.12/js/utils.js"
      });

      document.getElementById('date').addEventListener('change', function () {
        const date = new Date(this.value);
        const currentDate = new Date();
        if (date < currentDate.setHours(0, 0, 0, 0)) {
          alert('Date cannot be in the past');
          this.value = '';
          return;
        }

        const day = date.getDay();

        if (day === 0) { // Sunday
          document.getElementById('slot4-container').style.display = 'block';
          document.getElementById('slot5-container').style.display = 'block';
          document.getElementById('slot6-container').style.display = 'block';
        } else {
          document.getElementById('slot4-container').style.display = 'none';
          document.getElementById('slot5-container').style.display = 'none';
          document.getElementById('slot6-container').style.display = 'none';
        }
      });



      document.getElementById('appointmentForm').addEventListener('submit', function (event) {
        event.preventDefault();
        btnstatus = true;
        checkBtn.disabled = true;
        checkBtn.innerText = "Checking...";
        const slotElement = document.querySelector('input[name="slot"]:checked');
        if (!slotElement) {
          alert('Please select a slot.');
          return;
        }

        const slot = slotElement.value;
        const date = document.getElementById('date').value;
        const phone = iti.getNumber();
        const city = document.getElementById('city').value;

        fetch('/checkslot', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            // need to add bearer token here for auth 
          },
          body: JSON.stringify({
            date,
            slot,
            phone,
            city
          })
        })
          .then(response => response.json())
          .then(data => {
            if (data.redirect) {
              window.location.href = data.redirect;
            } else if (data.error) {
              alert(data.error);
              btnstatus = false;
              checkBtn.disabled = false;
              checkBtn.innerText = "Check Availability";
            } else if (data.errors) {
              alert(data.errors.map(err => err.msg).join('\n'));
              btnstatus = false;
              checkBtn.disabled = false;
              checkBtn.innerText = "Check Availability";
            }
          })
          .catch(error => {
            console.error('Error:', error);
            btnstatus = false;
            checkBtn.disabled = false;
            checkBtn.innerText = "Check Availability";
          });
      });
    });

    document.getElementById("checkBtn").disabled = btnstatus;
  </script>
  <%- include('footer') %>
</body>
<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

</html>