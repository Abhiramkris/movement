<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Appointment Notification</title>
    <link rel="stylesheet" href="css/imagetext.css">
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="css/aura.css">
    <link rel="stylesheet" href="css/nav.css">
    <link rel="stylesheet" href="css/footer.css">
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <!-- Font Awesome CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <!-- cdn tailwing -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-uWxY/CJNBR+1zjPWmfnSnVxwRheevXITnMqoEIeG1LJrdI0GlVs/9cVSyPYXdcSF" crossorigin="anonymous">
    <style>
   h5 {
        margin-top: 8px;
        font-weight: 800;
        color:  #023974;
        font-family: 'Poppins', sans-serif;
      }
      
.center-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100%;
}

.success-container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  border-radius: 10px;
  padding: 2rem;
  max-width: 600px;
  width: 100%;
}

.success-container h1 {
  font-size: 1.8rem;
  font-weight: 700;
  color: #4CAF50;
  margin-bottom: 1rem;
}

.popper {
  display: flex;
  justify-content: center;
}

.popper img {
  max-width: 100%;
  height: auto;
  border-radius: 5px;
}
    </style>
</head>
<body>
  <%- include('header') %>
  <script>
    $(document).ready(function() {
      $('.navbar-toggler').click(function() {
        $('#navbarNav').collapse('toggle');
      });
    });
  </script>
   <br><br><br><br>
  <div class="center-container">
    <div class="success-container">
      <div class="popper" id="popper">
        <img src="/images/ok.gif" alt="Success"> 
      </div> <br>
      <h1>We will be in contact soon</h1>
      <h7>You will be notified by mail or will be called <br>Thanks for trusting Movement-science</h7>
    </div>
  </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (!('Notification' in window)) {
                console.error('This browser does not support desktop notification.');
                return;
            }

            Notification.requestPermission().then(permission => {
                if (permission === 'granted') {
                    console.log('Notification permission granted.');
                } else {
                    console.error('Permission denied for notification.');
                }
            });

            // Example: Listen for notifications triggered by server
            const serverUrl = 'http://localhost:3000/send-notification';

            fetch(serverUrl)
                .then(response => response.json())
                .then(data => {
                    if (data.title && data.body) {
                        new Notification(data.title, { body: data.body });
                        showSuccessAnimation();
                    }
                })
                .catch(error => {
                    console.error('Error fetching notification:', error);
                });
        });

        function showSuccessAnimation() {
            const popper = document.getElementById('popper');
            popper.style.display = 'block';

            setTimeout(() => {
                window.location.href = '/added';
            }, 4000); // Redirect after 4 seconds
        }
    </script> <br><br><br><br><br><br><br><br>
     <%- include('footer') %>
</body>
</html>
